{
  "mcpServers": {
    "lark-mcp-server": {
      "command": "node",
      "args": ["${workspaceFolder}/index.js"],
      "env": {
        "FEISHU_PROFILE": "${FEISHU_PROFILE:-default}",
        "LARK_MCP_LOG_LEVEL": "${LARK_MCP_LOG_LEVEL:-info}"
      }
    }
  },
  "permissions": {
    "allow": [
      "node ${workspaceFolder}/**",
      "lark *"
    ],
    "deny": []
  }
}
